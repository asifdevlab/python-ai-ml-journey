# Fxn to compute sum of 2 numbers
def sum(a,b):
    print(a + b)    # a & b are parameters

print(sum(5,10))    # 5 & 10 are arguments

# Fxn to compute average of 3 numbers
def avg(a,b,c):
    return (a + b + c)/ 3

print(avg(1, 2, 3))

# sum() fxn with default parameter 1
def sum(a, b = 1):
    return a + b
print(sum(5))   # output: 6

# fxn to compute x^2
square = lambda x: x * x
print(square(5))


# Practice Problem (Set 3)

# 1. Create a function to compute factorial of a number n.

def calc_fact(n):
    fact = 1
    for i in range(1, n+1):
        fact *= i
    print(fact)

num = int(input("Enter a number: "))
calc_fact(num)

# 2. Create a function to return largest of 3 numbers - a, b & c.

def largest_of_three(a,b,c):
    if a >= b and a >= c:
        return a
    elif b >= a and b >= c:
        return b
    else:
        return c

print(largest_of_three(10,20,25))

